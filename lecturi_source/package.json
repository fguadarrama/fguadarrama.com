{
  "name": "lecturi",
  "version": "1.0.0",
  "description": "Lector EPUB web con microtipografía (Justif + Hyphenopoly)",
  "scripts": {
    "test:editor": "node --test tests/editor.test.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "npm run vendor",
