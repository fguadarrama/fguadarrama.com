  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "epubjs": "0.3.93",
    "hyphenopoly": "6.1.0",
    "jszip": "3.10.1",
    "justif": "0.9.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^6.4.5"
  },
  "private": true,
